# Copy to .env and adjust. All values are for LOCAL DEVELOPMENT ONLY - never reuse them in production.

# PostgreSQL container
POSTGRES_DB=northline
POSTGRES_USER=northline
POSTGRES_PASSWORD=northline_dev
# Host port for PostgreSQL (5433 avoids clashing with a locally installed PostgreSQL on 5432)
POSTGRES_PORT=5433

# API container
# Development enables Swagger-friendly behaviour and the POST /api/dev/reset endpoint.
ASPNETCORE_ENVIRONMENT=Development
# HMAC key for signing JWTs, at least 32 characters.
JWT_SIGNING_KEY=development-only-signing-key-not-for-production-0001
# Password given to every seeded development account.
SEED_DEV_PASSWORD=Northline!Dev2026

# Host ports
API_PORT=5080
WEB_PORT=8080
